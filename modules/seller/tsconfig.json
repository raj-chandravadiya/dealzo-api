{
  "compilerOptions": {
    "lib": ["es2017", "es7", "es6", "dom"],
    "declaration": true,
    "outDir": "./lib",
    "strict": true,
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "exclude": ["node_modules", "lib"],
  "typeRoots": ["./types", "./node_modules/@types"]
}
